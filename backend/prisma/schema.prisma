generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum PaymentType {
  CASH
  CARD
  MOBILE_MONEY
  INSURANCE
}

enum PrescriptionStatus {
  ACTIVE
  USED
  EXPIRED
  PENDING
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CASHIER)
  createdAt    DateTime @default(now())
  sales        Sale[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  loyaltyId String?  @unique
  createdAt DateTime @default(now())
  sales     Sale[]
}

model Product {
  id           String    @id @default(cuid())
  name         String
  category     String
  brand        String?
  sku          String?   @unique
  stock        Int       @default(0)
  reorderLevel Int       @default(10)
  cost         Float     @default(0)
  price        Float
  unit         String    @default("pcs")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  saleItems    SaleItem[]
}

model Prescription {
  id            String              @id @default(cuid())
  patientName   String
  doctorName    String
  medication    String
  dosage        String
  quantity      Int
  expiryDate    DateTime
  status        PrescriptionStatus  @default(ACTIVE)
  notes         String?
  createdAt     DateTime            @default(now())
}

model Sale {
  id          String     @id @default(cuid())
  saleNumber  String     @unique
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id])
  cashierId   String
  cashier     User       @relation(fields: [cashierId], references: [id])
  subtotal    Float
  discount    Float     @default(0)
  total       Float
  paid        Float
  paymentType PaymentType
  status      String     @default("COMPLETED")
  createdAt   DateTime   @default(now())
  saleItems   SaleItem[]
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  total     Float
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String
  createdAt DateTime @default(now())
  userId    String?
}
